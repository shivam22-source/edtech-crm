# Supabase pooler connection string. Copy it from Project Settings > Database > Connection string > Transaction pooler.
# Local Postgres example: postgres://postgres:postgres@localhost:5432/crm_dev
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h

# Exact frontend URL, no trailing slash. Used for CORS.
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

DB_POOL_MAX=10
BCRYPT_COST=12

# Rate limits: window in milliseconds, maximum requests per IP per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_LOGIN_MAX=10

# Used by the seed-admin script only. Do not store on the host after seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
